# ── Rust Backend API Keys (NOT prefixed with VITE_ — never exposed to frontend) ─

# OpenRouter — used for all non-NVIDIA models (Llama, Gemma, Mistral, DeepSeek, GPT-4o…)
# Get a free key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# NVIDIA NIM — used for Llama 4 Scout, Gemma 4, Nemotron, etc.
# Get a free key at https://build.nvidia.com (select a model → Get API Key)
NVIDIA_API_KEY=your_nvidia_api_key_here

# STT Provider: AssemblyAI — primary real-time streaming STT
# Get a key at https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Appwrite server-side API secret — used by Rust (usage.rs) to write rate-limit counters.
# NEVER use VITE_ prefix here — this must NOT reach the frontend bundle.
# Create in Appwrite Console: Project → Settings → API Keys → Add API Key (server scope)
APPWRITE_API_SECRET=your_appwrite_server_api_key_here

# ── Frontend Variables (VITE_ prefix — inlined into JS bundle at build time) ───

# Your production landing page and API base URL
VITE_APP_URL=https://yourapp.com
VITE_API_BASE_URL=https://yourapp.com/api
# Set to true ONLY during local development to skip token verification
VITE_SKIP_AUTH_CHECK=false

# ElevenLabs STT (optional)
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Appwrite ─────────────────────────────────────────────────────────────────────
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_DATABASE_ID=your_database_id

# Collection IDs (from Appwrite Console → Databases → your DB → Collections)
VITE_APPWRITE_COLLECTION_USER_PROFILES=user_profiles
VITE_APPWRITE_COLLECTION_CONVERSATIONS=conversations
VITE_APPWRITE_COLLECTION_SYSTEM_PROMPTS=system_prompts
VITE_APPWRITE_COLLECTION_USER_SETTINGS=user_settings
VITE_APPWRITE_COLLECTION_SCREENSHOTS=screenshot

# user_usage collection — rate-limit counters.
# Document Security: ON. Collection permissions: NONE (users have read-only on their own doc).
# Attributes needed: aiResponsesUsed (integer, max 600), listeningSecondsUsed (integer, max 40000)
VITE_APPWRITE_COLLECTION_USER_USAGE=user_usage

# Storage bucket ID for screenshot uploads
VITE_APPWRITE_BUCKET_SCREENSHOTS=your_screenshots_bucket_id
