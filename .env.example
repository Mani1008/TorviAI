# AI Provider Keys
VITE_MODELSLAB_API_KEY=your_modelslab_api_key_here
VITE_MODELSLAB_MODEL=anthropic-claude-sonnet-4.6

# ElevenLabs Speech-to-Text
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Auth (landing page integration)
VITE_APP_URL=https://yourlandingpage.com
VITE_API_BASE_URL=https://yourlandingpage.com/api
# Set to true during local development to bypass token verification
VITE_SKIP_AUTH_CHECK=false

# NVIDIA NIM API key for Gemma 4, Llama 4, Nemotron, etc.
# Get a free key at https://build.nvidia.com (select a model → Get API Key)
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Appwrite ──────────────────────────────────────────────────
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_DATABASE_ID=your_database_id

# Collection IDs (from Appwrite console)
VITE_APPWRITE_COLLECTION_USER_PROFILES=user_profiles_collection_id
VITE_APPWRITE_COLLECTION_CONVERSATIONS=conversations_collection_id
VITE_APPWRITE_COLLECTION_SYSTEM_PROMPTS=system_prompts_collection_id
VITE_APPWRITE_COLLECTION_USER_SETTINGS=user_settings_collection_id
