{
  "identifier": "gate-cap",
  "description": "Minimal capabilities for the auth gate window. No SQL, no shortcuts, no autostart.",
  "windows": ["gate"],
  "permissions": [
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://cloud.appwrite.io/**" },
        { "url": "https://*.cloud.appwrite.io/**" }
      ]
    }
  ]
}
